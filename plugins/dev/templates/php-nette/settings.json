{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(make db-import*)",
      "Bash(docker stop *)",
      "Bash(docker restart *)",
      "Bash(docker rm *)",
      "Bash(docker compose *down*)",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git switch *)"
    ],
    "deny": [
      "Edit(/vendor/**)",
      "Edit(/node_modules/**)"
    ]
  }
}
