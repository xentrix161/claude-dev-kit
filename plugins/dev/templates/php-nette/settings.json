{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(make db-import*)",
      "Bash(docker stop *)",
      "Bash(docker restart *)",
      "Bash(docker rm *)",
      "Bash(docker compose *down*)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune*)",
      "Bash(docker system prune*)",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git branch -D *)",
      "Bash(*composer require *)",
      "Bash(*composer update*)",
      "Bash(*composer remove *)",
      "Bash(*migrations:migrate*)",
      "Bash(*migrations:execute*)",
      "Bash(*migrations:version*)",
      "Bash(*migrations:rollup*)",
      "Bash(*migrations:diff*)",
      "Bash(*migrations:generate*)",
      "Bash(*schema:update*)",
      "Bash(*schema:create*)",
      "Bash(*schema:drop*)",
      "Bash(*schema-tool:*)",
      "Bash(*database:drop*)",
      "Bash(*dbal:run-sql*)",
      "Bash(*fixtures:load*)",
      "Bash(*phinx migrate*)",
      "Bash(*phinx rollback*)",
      "Bash(*phinx seed:run*)",
      "Bash(*phinx breakpoint*)"
    ],
    "deny": [
      "Edit(/vendor/**)",
      "Edit(/node_modules/**)"
    ]
  }
}
