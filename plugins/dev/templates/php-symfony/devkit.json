{
  "_init": [
    "Pokyny pre /dev:project-init — tento kľúč do projektu nezapisuj.",
    "lint a kroky vypusti pre chýbajúce balíky: .twig + lint-twig (symfony/twig-bundle), .yaml/.yml + lint-yaml (symfony/yaml), doctrine-schema (doctrine/doctrine-bundle), php-cs-fixer.",
    "phpunit a integration: init vyberie podľa phpunit.xml(.dist) — rýchla a pomalá <testsuite> (napr. unit, integration) → --testsuite <rýchla> v phpunit a --testsuite <pomalá> v integration; inak testy so skupinou integration → --exclude-group integration / --group integration; bez pomalých testov krok integration vypusti. V stop nechaj len rýchle kroky.",
    "doctrine-schema: lokálna DB trvalo mimo sync (drift indexov) → pridaj --skip-sync, inak commit gate pri zmene entít neprejde.",
    "fullWhen: config/doctrine/** ponechaj len pri XML/YAML mapovaní.",
    "Frontend: krok eslint a prípony .js, .ts v commitGate.ext ponechaj len keď package.json má eslint (dependencies/devDependencies) a projekt má jeho config; rovnako stylelint s .css, .scss; inak krok aj prípony vypusť bez otázky (AssetMapper bez package.json ich nemá). runtime host = Node na hostiteľovi; Node len v kontajneri z poľa container → runtime vypusť. eslint bez changedLinesOnly (výstup stylish nemá cestu na riadku nálezu). Guardy console-log a inner-html ponechaj vždy."
  ],
  "version": 1,
  "stack": "php-symfony",
  "container": "{{container}}",
  "appRoot": "{{appRoot}}",
  "lint": {
    ".php": ["php -l {file}"],
    ".twig": ["php bin/console lint:twig {file}"],
    ".yaml": ["php vendor/bin/yaml-lint --parse-tags {file}"],
    ".yml": ["php vendor/bin/yaml-lint --parse-tags {file}"]
  },
  "lintChangedLinesOnly": true,
  "check": {
    "steps": [
      {"id": "phpstan", "requires": "vendor/bin/phpstan",
       "run": "php vendor/bin/phpstan analyse -c {{phpstanConfig}} --no-progress --error-format=raw --memory-limit=1G",
       "runFiles": "php vendor/bin/phpstan analyse -c {{phpstanConfig}} --no-progress --error-format=raw --memory-limit=1G {files}",
       "ext": [".php"], "modes": ["stop", "quick", "full"], "changedLinesOnly": "stop"},
      {"id": "phpunit", "requires": "vendor/bin/phpunit", "run": "php vendor/bin/phpunit --exclude-group integration", "modes": ["stop", "quick", "full"]},
      {"id": "php-cs-fixer", "requires": "vendor/bin/php-cs-fixer",
       "runFiles": "php vendor/bin/php-cs-fixer fix --dry-run --diff --show-progress=none --path-mode=intersection {files}",
       "ext": [".php"], "modes": ["quick", "full"]},
      {"id": "lint-container", "requires": "bin/console", "run": "php bin/console lint:container", "modes": ["quick", "full"]},
      {"id": "lint-yaml", "requires": "vendor/symfony/yaml/composer.json", "run": "php bin/console lint:yaml config --parse-tags", "modes": ["quick", "full"]},
      {"id": "lint-twig", "requires": "vendor/symfony/twig-bundle/composer.json", "run": "php bin/console lint:twig templates", "modes": ["quick", "full"]},
      {"id": "eslint", "requires": "node_modules/.bin/eslint", "runtime": "host", "runFiles": "node_modules/.bin/eslint {files}", "ext": [".js", ".ts"], "modes": ["quick", "full"]},
      {"id": "stylelint", "requires": "node_modules/.bin/stylelint", "runtime": "host", "runFiles": "node_modules/.bin/stylelint --allow-empty-input --formatter unix {files}", "ext": [".css", ".scss"], "modes": ["quick", "full"]},
      {"id": "integration", "requires": "vendor/bin/phpunit", "run": "php vendor/bin/phpunit --group integration", "modes": ["full"]},
      {"id": "doctrine-schema", "requires": "vendor/doctrine/doctrine-bundle/composer.json", "run": "php bin/console doctrine:schema:validate", "modes": ["full"]}
    ],
    "fullWhen": ["src/Entity/**", "migrations/**", "config/doctrine/**", "config/packages/doctrine*.yaml", "config/packages/*/doctrine*.yaml"],
    "knownFailures": []
  },
  "guards": [
    {"id": "debug-php", "ext": [".php"], "pattern": "(^|[^>:$_[:alnum:]])(dump|dd|var_dump|print_r)\\(", "message": "debug výpis v kóde (dump/dd/var_dump/print_r)"},
    {"id": "debug-twig", "ext": [".twig"], "pattern": "(\\{%-?[[:space:]]*dump[[:space:]%-]|[^.[:alnum:]_]dump\\()", "message": "dump v šablóne"},
    {"id": "die", "ext": [".php"], "pattern": "(^|[^>:$_[:alnum:]])(die|exit)[[:space:]]*(\\(|;)", "message": "die()/exit() — vráť Response alebo vyhoď výnimku"},
    {"id": "twig-raw", "ext": [".twig"], "pattern": "\\|[[:space:]]*raw\\b", "message": "|raw vypína escapovanie — len na sanitizovaný obsah, s dôvodom"},
    {"id": "error-suppress", "ext": [".php"], "pattern": "^[[:space:]]*(@|([^*[:space:]/#]|/[^*/])(.*[^[:alnum:]_])?@)\\$?[a-zA-Z_]+\\(", "message": "potlačenie chyby operátorom @"},
    {"id": "sql-concat", "ext": [".php"], "pattern": "(SELECT|UPDATE|DELETE|INSERT)[^;]*['\"][[:space:]]*\\.[[:space:]]*\\$", "message": "SQL/DQL skladané reťazcom — použi parametre"},
    {"id": "dql-concat", "ext": [".php"], "pattern": "->(where|andWhere|orWhere|having|andHaving|orHaving)\\([^)]*['\"][[:space:]]*\\.[[:space:]]*\\$", "message": "podmienka QueryBuildera skladaná reťazcom — hodnoty cez setParameter(), názvy polí len z whitelistu"},
    {"id": "test-skip", "ext": [".php"], "pattern": "(->|::)mark(TestSkipped|TestIncomplete)\\(", "message": "vypnutý test (markTestSkipped/markTestIncomplete) — len so súhlasom používateľa, nie ako obídenie zlyhania"},
    {"id": "console-log", "ext": [".js", ".ts"], "pattern": "console\\.(log|debug)\\(", "message": "console.log/console.debug — ladiaci výpis pred commitom zmaž"},
    {"id": "inner-html", "ext": [".js", ".ts"], "pattern": "\\.innerHTML[[:space:]]*\\+?=([^=]|$)", "message": "priradenie do innerHTML vloží HTML bez escapovania (XSS) — text cez textContent, HTML len prečistené"}
  ],
  "pairs": [
    {"id": "entity-migration", "when": "src/Entity/**", "unless": "migrations/**",
     "say": "Zmena entity bez migrácie: spýtaj sa používateľa, či vygenerovať migráciu (doctrine:migrations:diff); bez súhlasu ju nevytváraj."}
  ],
  "secrets": {
    "patterns": [
      "(?i)(password|passwd|heslo|secret|api[_-]?key|token)[\"']?[[:space:]]*[:=]>?[[:space:]]*[\"'][^\"'[:space:]%$][^\"'[:space:]]{5,}",
      "^[[:space:]]*[A-Z0-9_]*(PASS|SECRET|TOKEN|API_KEY|PRIVATE_KEY|AUTH|_HASH)[A-Z0-9_]*[[:space:]]*[:=][[:space:]]*[\"']?[^[:space:]\"'%$][^[:space:]\"']{5,}",
      "[a-z][a-z0-9+.-]*://[^:/@[:space:]\"']*:[^@/[:space:]\"'%$!][^@/[:space:]\"']{3,}@",
      "-----BEGIN [A-Z ]*PRIVATE KEY-----",
      "AKIA[0-9A-Z]{16}"
    ],
    "allow": ["tests/", ".env.test", ".env.dev"],
    "forbidFiles": ["**/.env.local", "**/.env.*.local", ".env.local.php", "auth.json", "config/secrets/prod/*.decrypt.private.php", "config/jwt/private.pem"]
  },
  "migrations": {"paths": ["migrations/**"]},
  "testLock": {"ttlHours": 6},
  "stopCheck": true,
  "commitGate": {"enabled": true, "ext": [".php", ".twig", ".yaml", ".yml", ".xml", ".neon", ".sql", ".js", ".ts", ".css", ".scss"]},
  "handoffDoc": "docs/handoff.md",
  "disabledRules": []
}
