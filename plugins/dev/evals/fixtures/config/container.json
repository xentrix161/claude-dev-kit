{
  "version": 1,
  "stack": "shell",
  "container": "devkit-eval-shop",
  "appRoot": "/app",
  "lint": {
    ".sh": [{"run": "bash -n {file}", "runtime": "host"}]
  },
  "lintChangedLinesOnly": false,
  "check": {
    "steps": [
      {"id": "unit", "run": "bash tests/run.sh", "runtime": "host", "ext": [".sh"], "modes": ["stop", "quick", "full"]},
      {"id": "integration", "run": "bash tests/run.sh", "modes": ["quick", "full"]}
    ]
  },
  "guards": [],
  "pairs": [],
  "secrets": {"allow": [], "forbidFiles": []},
  "stopCheck": true,
  "commitGate": {"enabled": true, "ext": [".sh"]},
  "disabledRules": []
}
